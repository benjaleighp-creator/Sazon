<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>es</string>
	<key>CFBundleDisplayName</key>
	<string>Sazón</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>es</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GrupoCompartido</key>
	<string>group.pe.benjamin.sazon</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Sazón usa la cámara para tomar fotos de tus platos y para escanear códigos de barras de productos envasados.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Sazón lee tus pasos, calorías activas y peso de Apple Salud para ajustar tu meta del día. No sale de tu iPhone.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Sazón guarda en Apple Salud el peso que anotas en la app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sazón usa el micrófono solo mientras dictas lo que comiste.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sazón usa tu galería solo para que elijas una foto de tu plato y la IA identifique los alimentos.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Sazón convierte tu voz en texto para registrar lo que comiste. Luego ese texto se envía a la IA solo cuando tocas «Analizar».</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>ColorLanzamiento</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
